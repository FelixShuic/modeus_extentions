{
  "name": "Modeus Picker",
  "description": "Выбор и отправка учебных групп в Modeus",
  "version": "2.3.1",
  "manifest_version": 3,
  "action": {
    "default_popup": "html/index.html"
  },
  "permissions": ["webRequest", "tabs", "storage", "scripting", "alarms"],
  "host_permissions": ["https://urfu.modeus.org/*"],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://urfu.modeus.org/learning-path-selection/*"],
      "js": ["js/menu.js"],
      "css": ["css/menu.css"],
      "run_at": "document_idle"
    }
  ]
}
